# ============================================================
# OrbitWatcher Environment Configuration
# ============================================================
# Copy this file to .env for local development:
#
#   cp .env.example .env
#
# Do not commit your actual .env file.
# Values below match OrbitWatcher's application defaults unless
# otherwise noted.
# ============================================================


# ── Server ──────────────────────────────────────────────────

# Network interface used by the FastAPI server.
# 0.0.0.0 is required for Docker and hosted deployments.
HOST=0.0.0.0

# Application port.
# Hosting platforms such as Render may provide PORT automatically.
PORT=8000


# ── CORS ────────────────────────────────────────────────────

# Comma-separated list of origins allowed to access the API.
# Development:
# ALLOWED_ORIGINS=*
#
# Production example:
# ALLOWED_ORIGINS=https://orbitwatcher.onrender.com
#
# Multiple origins:
# ALLOWED_ORIGINS=https://example.com,https://www.example.com
ALLOWED_ORIGINS=*


# ── Scheduler & TLE Fetching ────────────────────────────────

# Hours between automatic pipeline runs.
SCHEDULER_INTERVAL_HOURS=6

# Number of times a failed TLE fetch is retried.
FETCH_RETRY_LIMIT=3

# Delay in seconds between TLE fetch retries.
FETCH_RETRY_DELAY_SECONDS=10


# ── Conjunction Screening ───────────────────────────────────

# Maximum distance in kilometres for a satellite pair to be
# classified as a conjunction.
CONJUNCTION_THRESHOLD_KM=50.0

# Reserved orbital-shell partition width in kilometres.
# Currently not used by the active single KDTree screening method,
# but retained for future multi-shell/multi-operator experiments.
ORBITAL_SHELL_THICKNESS_KM=100.0


# ── Risk Scoring ────────────────────────────────────────────

# Maximum relative velocity used by the risk-scoring model (km/s).
MAX_RELATIVE_VELOCITY_KM_S=15.0

# Minimum risk score used for risk-alert classification.
RISK_ALERT_THRESHOLD=0.05


# ── Database ────────────────────────────────────────────────

# SQLite database location.
DATABASE_PATH=data/orbitwatch.db


# ── Logging ─────────────────────────────────────────────────

# Application log file location.
LOG_FILE=logs/orbitwatch.log

# Logging level: DEBUG, INFO, WARNING, ERROR, or CRITICAL.
LOG_LEVEL=INFO

# Maximum size of one log file before rotation.
# Default: 5 MiB = 5 * 1024 * 1024 bytes.
LOG_MAX_BYTES=5242880

# Number of rotated log files retained.
LOG_BACKUP_COUNT=5
